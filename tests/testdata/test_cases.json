  "invalid_inputs": [
    { "name": "invalid_json", "lang": "json", "input": "{invalid}", "expect_error": true },
    { "name": "invalid_xml", "lang": "xml", "input": "<root><unclosed>", "expect_error": true },
    { "name": "invalid_yaml", "lang": "yaml", "input": "{: :}", "expect_error": true }
  ],
  "cli_tests": [
    {
      "name": "format_json_stdin",
      "args": ["-l", "json", "format"],
      "stdin": "{\"a\":1,\"b\":2}",
      "checks": ["\"a\": 1"]
    },
    {
      "name": "compress_json_stdin",
      "args": ["-l", "json", "compress"],
      "stdin": "{\n  \"a\": 1,\n  \"b\": 2\n}",
      "checks": ["\"a\":1"]
    },
    {
      "name": "highlight_json_stdin",
      "args": ["-l", "json", "highlight"],
      "stdin": "{\"a\":1}",
      "checks": ["<"]
    },
    {
      "name": "format_yaml_stdin",
      "args": ["-l", "yaml", "format"],
      "stdin": "name: test\nitems:\n    - one\n    - two",
      "checks": ["name: test", "  - one"]
    },
    {
      "name": "format_xml_stdin",
      "args": ["-l", "xml", "format"],
      "stdin": "<root><item>1</item></root>",
      "checks": ["<root>", "  <item>1</item>"]
    },
    {
      "name": "format_html_stdin",
      "args": ["-l", "html", "format"],
      "stdin": "<html><body><p>hi</p></body></html>",
      "checks": ["<html>", "<p>"]
    },
    {
      "name": "format_go_stdin",
      "args": ["-l", "go", "format"],
      "stdin": "package main\n\nfunc main(){println(\"hi\")}",
      "checks": ["func main() {"]
    },
    {
      "name": "format_shell_stdin",
      "args": ["-l", "shell", "format"],
      "need_tool": "shfmt",
      "stdin": "if true; then\necho hi\nfi",
      "checks": ["echo hi"]
    },
    {
      "name": "format_javascript_stdin",
      "args": ["-l", "javascript", "format"],
      "need_tool": "oxfmt-wrapper",
      "stdin": "const x=1;",
      "checks": ["const x = 1;"]
    },
    {
      "name": "format_typescript_stdin",
      "args": ["-l", "typescript", "format"],
      "need_tool": "oxfmt-wrapper",
      "stdin": "let n:number=1;",
      "checks": ["number", "= 1;"]
    },
    {
      "name": "format_css_stdin",
      "args": ["-l", "css", "format"],
      "need_tool": "oxfmt-wrapper",
      "stdin": ".a{color:red}",
      "checks": ["color: red"]
    },
    {
      "name": "format_java_stdin",
