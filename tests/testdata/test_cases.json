{
  "$comment": "Golden file 测试配置: 每种语言按目录 (tests/testdata/{lang}/) 组织输入和期望输出文件。用例定义操作 (format/compress/beautify)、选项 (tab_width[-1=Tab]/style)、测试方式 (pipeline/cli)。运行 `go test -update` 生成期望文件。",
  "languages": {
    "json": {
      "backend": "native",
      "cases": [
        {
          "name": "format_2spaces",
          "operation": "format",
          "input": "input.json",
          "expected": "format_2spaces.expected",
          "options": { "tab_width": 2 },
          "methods": ["pipeline", "cli"]
        },
        {
          "name": "format_4spaces",
          "operation": "format",
          "input": "input.json",
          "expected": "format_4spaces.expected",
          "options": { "tab_width": 4 },
          "methods": ["pipeline"]
        },
        {
          "name": "format_tabs",
          "operation": "format",
          "input": "input.json",
          "expected": "format_tabs.expected",
          "options": { "tab_width": -1 },
          "methods": ["pipeline"]
        },
        {
          "name": "compress",
          "operation": "compress",
          "input": "input.json",
          "expected": "compress.expected",
          "methods": ["pipeline"]
        },
        {
          "name": "beautify_monokai",
          "operation": "beautify",
          "input": "input.json",
          "expected": "beautify_monokai.expected",
          "options": { "style": "monokai" },
          "methods": ["pipeline"]
        },
        {
          "name": "edge_format",
          "operation": "format",
          "input": "edge_input.json",
          "expected": "edge_format.expected",
          "options": { "tab_width": 2 },
          "methods": ["pipeline"]
        },
        {
          "name": "edge_empty_object",
          "operation": "format",
          "input": "edge_empty_input.json",
          "expected": "edge_empty_object.expected",
          "methods": ["pipeline"]
        }
