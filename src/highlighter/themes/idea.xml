  <entry type="KeywordReserved" style="bold #0033b3"/>
  <entry type="KeywordType" style="bold #0033b3"/>
  <entry type="Name" style="#000000"/>
  <entry type="NameAttribute" style="#008080"/>
  <entry type="NameBuiltin" style="#0033b3"/>
