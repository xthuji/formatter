<style name="idea">
  <!-- IntelliJ IDEA Default Light Theme -->
  <entry type="Background" style="bg:#ffffff"/>
  <entry type="Text" style="#000000"/>
  <entry type="Keyword" style="bold #0033b3"/>
  <entry type="KeywordConstant" style="bold #0033b3"/>
  <entry type="KeywordDeclaration" style="bold #0033b3"/>
  <entry type="KeywordNamespace" style="bold #0033b3"/>
